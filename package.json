{
  "name": "better-review",
  "private": true,
  "license": "MIT",
  "bin": {
    "better-review": "./index.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev:api": "OPENCODE_PORT=4096 bun run --cwd packages/better-review dev",
    "dev:web": "bun run --cwd packages/web dev",
    "dev": "concurrently 'npm:dev:api' 'npm:dev:web' --names api,web --colors",
    "start": "bun run --cwd packages/web build && bun run --cwd packages/better-review start",
    "test": "bun test",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist && bun install",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "./node_modules/.bin/lefthook install"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "concurrently": "^9.1.2",
    "lefthook": "^2.1.5",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.59.0"
  },
  "peerDependencies": {},
  "overrides": {
    "picomatch": "4.0.4",
    "rollup": "4.59.0",
    "vite": "8.0.8",
    "vitefu": "1.1.3",
    "yaml": "2.8.3"
  }
}

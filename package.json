{
  "name": "better-review",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev:api": "OPENCODE_PORT=3002 bun run --cwd packages/better-review dev",
    "dev:web": "bun run --cwd packages/web dev",
    "dev": "concurrently 'npm:dev:api' 'npm:dev:web' --names api,web --colors",
    "start": "bun run --cwd packages/web build && bun run --cwd packages/better-review start",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist && bun install",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "./node_modules/.bin/lefthook install"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "concurrently": "^9.1.2",
    "lefthook": "^2.1.1",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0"
  },
  "peerDependencies": {}
}

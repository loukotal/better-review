{
  "name": "better-review-workspace",
  "private": true,
  "license": "MIT",
  "bin": {
    "better-review": "./index.ts"
  },
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "ensure:dev-token": "node scripts/ensure-dev-token.mjs",
    "wait:api": "node scripts/wait-for-api.mjs",
    "dev:api": "pnpm --filter ./packages/better-review dev",
    "dev:web": "pnpm --filter ./packages/web dev",
    "dev": "pnpm ensure:dev-token && concurrently --kill-others-on-fail --names api,web --prefix-colors blue,green \"pnpm dev:api\" \"pnpm wait:api && pnpm dev:web\"",
    "start": "pnpm --filter ./packages/web build && pnpm --filter ./packages/better-review start",
    "test": "node --import tsx --test \"packages/**/*.test.ts\"",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist && pnpm install",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@better-review/shared": "workspace:*"
  },
  "devDependencies": {
    "@flue/cli": "^0.8.1",
    "@types/node": "25.6.2",
    "concurrently": "9.2.1",
    "lefthook": "2.1.6",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "rollup": "4.59.0",
    "vite": "8.0.9",
    "vitefu": "1.1.3",
    "yaml": "2.8.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.1.1"
}

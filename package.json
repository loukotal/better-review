{
  "name": "better-review-workspace",
  "private": true,
  "license": "MIT",
  "bin": {
    "better-review": "./index.ts"
  },
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev:api": "pnpm --filter ./packages/better-review dev",
    "dev:web": "pnpm --filter ./packages/web dev",
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "start": "pnpm --filter ./packages/web build && pnpm --filter ./packages/better-review start",
    "test": "node --import tsx --test \"packages/**/*.test.ts\"",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist && pnpm install",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@better-review/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.6.2",
    "concurrently": "9.2.1",
    "lefthook": "2.1.6",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.1.1"
}

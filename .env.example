# Port for the better-review API server
API_PORT=3001

# Hostname for the better-review API server (defaults to 127.0.0.1)
# Set to 0.0.0.0 only if you intentionally want to expose it on your network.
# API_HOST=127.0.0.1

# Port for the web dev server (Vite)
WEB_PORT=3000

# Port for the OpenCode server (REQUIRED - server hangs without it)
OPENCODE_PORT=4096

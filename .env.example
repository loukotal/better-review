# Port for the better-review API server
API_PORT=3001

# Optional override for the local API token.
# In dev, `pnpm dev` creates .better-review-api-token automatically.
# For production/start, set a long random value, for example: openssl rand -hex 32
# BETTER_REVIEW_API_TOKEN=

# Optional for production builds: bake the same token into the built client.
# In dev, Vite automatically reuses BETTER_REVIEW_API_TOKEN or .better-review-api-token.
# If omitted in production, the browser UI prompts once and stores the token in localStorage.
# VITE_BETTER_REVIEW_API_TOKEN=

# Hostname for the better-review API server (defaults to 127.0.0.1)
# Set to 0.0.0.0 only if you intentionally want to expose it on your network.
# API_HOST=127.0.0.1

# Port for the web dev server (Vite)
WEB_PORT=3000

# Optional port for the embedded OpenCode server.
# Leave unset, or set to 0, to use a random free local port.
# OPENCODE_PORT=0

# Temporary escape hatch for local development only.
# BETTER_REVIEW_DISABLE_API_AUTH=1
